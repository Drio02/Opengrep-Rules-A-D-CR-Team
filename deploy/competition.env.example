# ---------------------------------------------------------------------
# Competition settings for the deploy scripts.
#
#   cp deploy/competition.env.example deploy/competition.env
#   nano deploy/competition.env        # fill in the values of the portal
#
# deploy/competition.env is git-ignored: never commit it, and never put
# private keys in this repository (it is public).
# Values below are the ECSC 2026 practice environment (team 39).
# ---------------------------------------------------------------------

# --- network (competition portal -> "Network") -------------------------
TEAM_NET=10.60.39.0/24          # Team subnet
VULNBOX_IP=10.60.39.2           # Your Vulnbox
EXPLOITER_IP=10.60.39.3         # Your Exploiter (the dashboard runs here)

# --- SSH ------------------------------------------------------------------
# Team private key (the one deployed in the portal). Path on THIS laptop.
TEAM_KEY=~/.ssh/ecsc2026
VULNBOX_USER=root
EXPLOITER_USER=root             # root, or a user with passwordless sudo
VULNBOX_SERVICES_DIR=/root/services
# Key that already exists ON THE EXPLOITER and logs into the vulnbox.
# Leave empty to copy TEAM_KEY to the exploiter instead.
VULNBOX_KEY_ON_EXPLOITER=/root/.ssh/pull

# Optional team git server (user git). Leave empty if there is none.
GIT_SERVER_IP=
GIT_SERVER_USER=git

# --- dashboard --------------------------------------------------------------
DASH_PORT=8765                  # fixed port: never 3001 nor a service port
DASH_ALLOW=10.60.39.0/24        # who may open it (comma separated CIDRs)
DASH_DENY=                      # always rejected, e.g. 10.60.39.1,10.60.39.2 (empty by team decision)
DASH_USER=addash                # unprivileged user that runs the dashboard

# --- code -------------------------------------------------------------------
REPO_URL=https://github.com/Drio02/Opengrep-Rules-A-D-CR-Team.git
REPO_BRANCH=ecsc2026/web-dashboard   # use "main" once the PRs are merged
OPENGREP_VERSION=1.30.0
# sha256 of opengrep_manylinux_x86 v1.30.0 (checked before installing it)
OPENGREP_SHA256=35779bdd72e92129c8df2a77f0c55e8c08356801ea92591ef32108d6b28d564c
